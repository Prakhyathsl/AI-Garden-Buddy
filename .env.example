# =======================================================
# AI Garden Buddy - Environment Configuration
# =======================================================

# Gemma Inference Backend:
# Options: "auto", "ollama", "groq", "openrouter", "huggingface", "openai_compatible", "demo"
GEMMA_BACKEND=auto

# Preferred Local Gemma Model:
GEMMA_MODEL=gemma2:9b

# Ollama Endpoint (Default local daemon):
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Gemma Inference Providers (Optional fallbacks):
# If using Google AI Studio (Official Gemma endpoints):
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# If using Groq:
GROQ_API_KEY=your_groq_api_key_here

# If using OpenRouter:
OPENROUTER_API_KEY=your_openrouter_api_key_here

# If using Hugging Face Inference:
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Generic OpenAI-compatible Gemma server (vLLM, llama.cpp):
# GEMMA_BASE_URL=http://localhost:8080/v1
# GEMMA_API_KEY=

# Server & Timeout Settings:
PORT=8000
INFERENCE_TIMEOUT_SECONDS=45.0

# Frontend Next.js API URL:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
